class Solution {
public:
    bool isBipartite(vector<vector<int>>& graph) {
        int n = graph.size();
        vector<int> color(n, -1);
        bool ans = true;
        for(int i = 0; i < n && ans; i++) {
            if(color[i] == -1)
                dfs(graph, i, color, 1, ans);
        }
        return ans;
    }
    
     void dfs(vector<vector<int>>& graph, int curr, vector<int> &color, int prev, bool &ans) {
         if(!ans)
             return;
         if(color[curr] != -1) {
             if((color[curr]^prev) == 0) {
                 ans = false;
             }
            return;
         }
         color[curr] = 1^prev;
         for(int j = 0; j < graph[curr].size(); j++) 
            dfs(graph, graph[curr][j], color, color[curr], ans);
     }
};
