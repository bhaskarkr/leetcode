class Solution {
public:
    vector<int> arraysIntersection(vector<int>& arr1, vector<int>& arr2, vector<int>& arr3) {
        vector<int> ans;
        for(int i = 0, j = 0, k = 0; i < arr1.size() && j < arr2.size() && k < arr3.size();) {
            int curr = max(arr1[i], max(arr2[j], arr3[k]));
            while(i< arr1.size() && curr > arr1[i])
                i++;
            while(j< arr2.size() && curr > arr2[j])
                j++;
            while(k< arr3.size() && curr > arr3[k])
                k++;
            if( i< arr1.size() && j< arr2.size() && k < arr3.size() && arr1[i] ==  arr2[j] &&  arr2[j] == arr3[k]) {
                ans.push_back(arr1[i]);
                i++, j++, k++;
            }
                
        }
        return ans;
    }
};
