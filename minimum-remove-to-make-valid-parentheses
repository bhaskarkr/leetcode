/*
    TC - O(N)
    SC - O(N)
    Steps:
        1. we will maintain a stack for open brackets and vector<int> to be ignored
        2. for every encounter of open bracket we will push it to stack
        3. for every closing bracket
            a. if stack is empty mark the index as ignore
            b. else pop from the stack
        4. for all the left over index in stack, mark all of them as ignore
        5. recontruct the ans string, and ignore the indeices marked true
        6. return ans
*/
class Solution {
public:
    string minRemoveToMakeValid(string s) {
        stack<int> openBracketStack;
        vector<bool> ignore(s.length());
        char openBracket = '(';
        for(int i = 0; i < s.length(); i++) {
            if(isalpha(s[i]))
                continue;
            else if(s[i] == openBracket) {
                openBracketStack.push(i);
            } else {
                if(openBracketStack.empty()) {
                    ignore[i] = true;
                } else {
                    openBracketStack.pop();
                }
            }
        }
        while(!openBracketStack.empty()) {
            ignore[openBracketStack.top()] = true;
            openBracketStack.pop();
        }
        string ans = "";
        for(int i = 0; i < s.length(); i++) {
            if(!ignore[i])
                ans+=s[i];
        }
        return ans;
    }
};
