class Solution {
public:
    /*
        Bucket sort
        TC - O(N)
        SC - O(N)
    */
    vector<int> topKFrequent(vector<int>& nums, int k) {
        unordered_map<int, int> map;
        vector<int> ans(k);
        for(int num : nums)
            map[num]++;
        vector<vector<int>> bucket(nums.size() + 1);
        for(auto [key, val] : map) {
            bucket[val].push_back(key);
        }
        for(int i = bucket.size() - 1 ; i >= 0 && k; i--)
            for(int j = 0; j < bucket[i].size() && k; j++)
                ans[--k] = bucket[i][j];
        return ans;
    }
    
