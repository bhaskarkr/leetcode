/*
    TC - log(n)
    SC - O(1)
    Steps:
        1. Binary search 
        2. we will find "l" such that atleast k missing element are on the left side of it including it.
        ex - 12347  k = 3
             000023
             1->5, 2->6, 3->7
             l = 0, r = 4, m = 2, (3 - 2 - 1 = 0 missing < k)
             l = 3, r = 4, m = 3, (4 - 3 - 1 = 0 missing < k)
             l = 4, r = 4, m = 4, (8 - 4 - 1 = 3 missing == k)
             l-1 = last index miss < k
             k will be between arr[l-1] and arr[l]
             arr[l-1] + k - miss[l-1]
             arr[l-1] + k - (arr[l-1] - (i-1) -1)
        3. return l + k
*/
class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        int l = 0, r = arr.size() - 1;
        while(l<=r) {
            int m = (l+r)/2;
            if(arr[m] - m -1 < k) {
                l = m + 1;
            } else {
                r = m - 1;
            }
        }
        //arr[l-1]  + k - (arr[l-1] - (l-1) -1 )
        return l + k;
    }
};


class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        int prev = 0;
        for(int i = 0; i < arr.size(); i++) {
            if(arr[i] - prev > 1) {
                if(k >= arr[i] - prev)
                    k -= arr[i] - prev - 1;
                else
                    return prev + k;
            }
            prev = arr[i];
        }
        return arr.back() + k;
    }
};
