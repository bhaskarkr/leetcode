/*
    TC - O(N)
    SC - O(1)
    Steps:
        1 2 7 5 4 3
                <-^
        1 2 7 5 4 3 (2 < 7)
          ^(i = 1)
        1 2 7 5 4 3(find the first value greater than i, in the right)
          i       ^(j = 5 and 3 > 2, so break)
        1 3 7 5 4 2(swapped)
            ^     ^ 
        (reverse, from decreasing to increasing)
*/
class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int i = nums.size() - 2;
        while(i >= 0 && nums[i] >= nums[i+1]) {
            i--;
        }
        if(i >= 0) {
            int j = nums.size() - 1;
            while(nums[j] <= nums[i])
                j--;
            swap(nums[i], nums[j]);
        }
        reverse(nums.begin() + i + 1, nums.end());
    }
};
