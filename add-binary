
/*
    TC  - O(max(N, M))
    SC  - O(max(N, M))
    Steps:
        1. we will start from right end
        2. we keep adding the current char to carry
        3. add cary mod 2 to ans in the beginning
        4. once loop gets over, add carry if non zero
        5. return ans
        
*/
class Solution {
public:
    string addBinary(string a, string b) {
        int j = b.length() - 1, i = a.length() - 1;
        string ans = "";
        int carry = 0;
        while(j >= 0   || i >= 0 ) {
            if(j < b.length())
                carry += b[j--] - '0';
            if(i < a.length())
                carry += a[i--] - '0';
            ans = to_string(carry%2) + ans;
            carry/=2;
        } 
        if(carry)
           ans = to_string(carry%2) + ans; 
        return ans;
    }
};
