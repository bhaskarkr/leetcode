class Solution {
public:
    string reorganizeString(string s) {
        unordered_map<char, int> map;
        int maxCount = 0;
        char maxLetter = '*';
        for(char c: s) {
            map[c]++;
            if(map[c] > maxCount) {
                maxCount = map[c];
                maxLetter = c;
            }
                
        }
        if(maxCount > (s.length() + 1) / 2)
            return "";
        int i = 0;
        while(map[maxLetter]-- > 0) {
            s[i] = maxLetter;
            i += 2;
        }
            
        for(auto [k, v] : map) {
            while(map[k]-- > 0) {
                if(i >= s.length())
                    i = 1;
                s[i] = k;
                i += 2;
            }
        }
        return s;
    }
};
