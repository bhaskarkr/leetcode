class Solution {
public:
    string reorganizeString(string s) {
        int n = s.length();
        vector<pair<int, int>> cn(26);
        string ans = string(n, ' ');
        for(char c : s) {
            cn[c - 'a'].first++;
            cn[c - 'a'].second = c - 'a';
            if(cn[c - 'a'].first > (n + 1) / 2)
                return "";
        }
        sort(cn.rbegin(), cn.rend());
        for(int i = 0, j = 0; i < 26; i++) {
            while(cn[i].first-- > 0) {
                if(j >= n)
                    j = 1;
                ans[j] = cn[i].second + 'a';
                j += 2;
            }
        }
        return ans;
    }
};

class Solution {
public:
    string reorganizeString(string s) {
        unordered_map<char, int> map;
        int maxCount = 0;
        char maxLetter = '*';
        for(char c: s) {
            map[c]++;
            if(map[c] > maxCount) {
                maxCount = map[c];
                maxLetter = c;
            }
                
        }
        if(maxCount > (s.length() + 1) / 2)
            return "";
        int i = 0;
        while(map[maxLetter]-- > 0) {
            s[i] = maxLetter;
            i += 2;
        }
            
        for(auto [k, v] : map) {
            while(map[k]-- > 0) {
                if(i >= s.length())
                    i = 1;
                s[i] = k;
                i += 2;
            }
        }
        return s;
    }
};
