class Solution {
public:
    vector<int> di = {0, 1, 0, -1}, dj = {1, 0, -1, 0};
    int numIslands(vector<vector<char>>& grid) {
        int ans = 0, n = grid.size(), m = grid[0].size();
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(grid[i][j] == '1') {
                    markIsland(grid, i, j, n, m);
                    ans++;
                }
            }
        }
        return ans;
    }
    
    void markIsland(vector<vector<char>>& grid, int i, int j, int n, int m) {
        grid[i][j]-=1;
        for(int d = 0; d < 4; d++) {
            int ni = i + di[d];
            int nj = j + dj[d];
            if(ni >= n || ni < 0 || nj >= m || nj < 0 || grid[ni][nj] != '1')
                continue;
            markIsland(grid, ni, nj, n, m);
        }
    }
};


class Solution {
public:
    int numIslands(vector<vector<char>>& grid) {
        vector<int> dx = {-1, 0, 1, 0}, dy = {0, 1, 0, -1};
        int ans = 0;
        function<void(int, int)> dfs = [&](int i, int j) {
            for(int d = 0; d < 4; d++) {
                int nx = i + dx[d];
                int ny = j + dy[d];
                if(nx < 0 || ny < 0 || nx >= grid.size() || ny >= grid[0].size() || grid[nx][ny] == '0') {
                    continue;
                }
                grid[nx][ny] = '0';
                dfs(nx, ny);
            }
        };
        for(int i = 0; i < grid.size(); i++) {
            for(int j = 0; j < grid[0].size(); j++) {
                if(grid[i][j] == '1') {
                    ans++;
                    dfs(i, j);
                }
            }
        }

        return ans;
    }
};
