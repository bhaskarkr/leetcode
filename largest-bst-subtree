/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Response {
    public:
        int minVal;
        int maxVal;
        int maxSize;
        Response(int val1, int val2, int val3) {
            minVal = val1;
            maxVal = val2;
            maxSize = val3;
        }
};
class Solution {
public:
    int largestBSTSubtree(TreeNode* root) {
        return helper(root)->maxSize;
    }
    Response* helper(TreeNode* root) {
        if(!root)
            return new Response(INT_MAX, INT_MIN, 0);
        Response* left = helper(root->left);
        Response* right = helper(root->right);
        if(root->val > left->maxVal && root->val < right->minVal)
            return new Response (min(left->minVal, root->val), max(right->maxVal, root->val), left->maxSize + right->maxSize + 1);
        return new Response(INT_MIN, INT_MAX, max( left->maxSize, right->maxSize));        
    }
};

