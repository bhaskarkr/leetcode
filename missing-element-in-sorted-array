
class Solution {
public:
    int missingElement(vector<int>& nums, int k) {
        int l = 0, r = nums.size() - 1;
        while(l <= r) {
            int m = (l + r) / 2;
            int missing = (nums[m] - nums[0] - 1) - (m - 1);
            if(missing < k) {
                // till "m" missing is less than k
                // so l = m + 1
                // we want l to point were missing >= k
                // so that the kth missing element will lie b/w l-1 and l
                l = m + 1;
            } else
                r = m - 1;
        }
        // l - 1 -> because l points to next position were missing element will be found
        // i.e missing element will be found between l - 1 and l
        return nums[0] + k + (l - 1); 
    }
    
