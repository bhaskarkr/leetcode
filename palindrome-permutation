class Solution {
public:
    bool canPermutePalindrome(string s) {
        bool odd = false;
        bool isOdd = s.length() % 2 == 1;
        vector<int> count(26);
        for(char c : s)
            count[c-'a']++;
        for(int c : count) {
            if(c%2) {
                if(!isOdd || odd)
                    return false;
                odd = true;
            }   
        }
        return true;
    }
};
