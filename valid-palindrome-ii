/*
    TC - O(n)
    SC - O(1)
    Steps:
        1. we will use 2 pointer approach, l = 0 and r = n-1
        2. keep l++ and r-- until a mismatch is found
        3. check 2 possibilies for palindrome 
            a. l + 1 to r
            b. l to r - 1
            c. return the if either is true otherwise false
        4. return true by default            
*/

class Solution {
public:
    bool validPalindrome(string s) {
        int l = 0, r = s.length() - 1;
        while(l<r) {
            if(s[l] != s[r]) {
                return checkPalin(s, l+1, r) | checkPalin(s, l, r-1);
            }
            l++, r--;
        }
        return true;
    }
    
    bool checkPalin(string s, int l, int r) {
        while(l<r) {
            if(s[l++] != s[r--])
                return false;
        }
        return true;
    }
};

class Solution {
public:
    bool is_palin(string &s, int l, int r) {
        while(l < r) {
            if(s[l] != s[r])
                return false;
            l++, r--;
        }
        return true;
    }
    bool validPalindrome(string s) {
        int l = 0, r = s.length() - 1;
        while(l < r) {
            if(s[l] != s[r]) {
                return is_palin(s, l, r - 1) || is_palin(s, l + 1, r);
            }
            l++, r--;
        }
        return true;
    }
};
