class Solution {
public:
    int countSubstrings(string s) {
        int ans = 0;
        for(int i = 0; i < s.length(); i++)
            ans += isPalindrome(s, i, i + 1) + isPalindrome(s, i, i);
        return ans;
    }

    int isPalindrome(string &s, int l, int r) {
        while(l >= 0 && r < s.length()) {
            if(s[l] != s[r])
                break;
            l--;
            r++;
        }
        return (r - l) / 2;
    }
};

class Solution {
public:
    int countSubstrings(string s) {
        int ans = 0;
        for(int point = 0; point < s.length(); point++) {
            // odd length 3 2 1 2 3
            ans += countPalindromeFromMid(s, point, point);
            // even length 3 2 1 1 2 3
            ans += countPalindromeFromMid(s, point, point + 1);
        }
        return ans;
    }
    
    int countPalindromeFromMid(string s, int l, int r) {
        int count = 0;
        while(l >= 0 && r < s.length() && s[l] == s[r]) {
            l--;
            r++;
            count++;
        }
        return count;
    }
};
