/*
    TC - O(N)
    SC - O(1)
    Steps:
        1. sliding window
        2. we will keep increasing "j", until we have enought k i.e k>0, while decreasing k
        3. once k < 0, we will increase i and j both, and if num[i] == 0, it means we got one '0' removed, 
            so increment k 
*/

class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int i = 0, j = 0;
        while(j < nums.size()) {
            if(nums[j]==0)
                k--;
            if(k < 0) {
                if(nums[i] == 0)
                    k++;
                i++;
            }
            j++;
        }
        return j - i;
    }
};



class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int l = 0, r = 0, ans = 0;
        while(r < nums.size()) {
            if(nums[r] == 0)
                k--;
            while(k < 0) {
                if(nums[l] == 0)
                    k++;
                l++;
            }
            ans = max(ans, r - l + 1);
            r++;
        }
        return ans;
    }
};
