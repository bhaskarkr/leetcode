/*
   TC - O(N)
   SC - O(1)
   Steps:
    1. we will take a inorder traversal approach
    2. we will pass a &prev, which will store the last node traversed
    3.      3
           / \
          2   1
         / \
        4   5
        prev = head
        lets say, we are at 4, so we will set 4->left = prev, and set prev = 4
        now come back to 2, now prev(4)->right = curr(2) and curr(2)->left = prev(4)
        and prev(4) = curr(2)
    4. once whole tree is mapped, we will need to map the last and the first node
    5. So prev will be pointing to the rightmost node, and first node is at head->right
    6. set prev->right = head->right and head->right->left = prev
    7. return head->right
*/

class Solution {
public:
    
    void solver(Node* curr, Node* &prev) {
        if(!curr)
            return;
        solver(curr->left, prev);
        prev->right = curr;
        curr->left = prev;
        prev = curr;
        solver(curr->right, prev);
    }
    
    Node* treeToDoublyList(Node* root) {
        if(!root)
            return root;
        Node* head = new Node(123);
        Node* prev = head;
        solver(root, prev);
        prev->right = head->right;
        head->right->left = prev;
        return head->right;
    }
};
