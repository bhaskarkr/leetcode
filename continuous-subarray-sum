
/*
    TC - O(N)
    SC - O(N)
    Steps:
        1. we will maintian a map with mod(%) values found till now to its index
        2. we will intialize mod 0 as -1 index and sum = 0
        3. for each num, we will add it to sum and take mod with k
        4. now we will check if this mode found before also it means sum of nums in between is multiple of k
        5. Since we have to include atleast 2 nums, we will futher check if curr index - previous index > 1. if yes return true
    
*/
class Solution {
public:
    bool checkSubarraySum(vector<int>& nums, int k) {
        int sum = 0;
        unordered_map<int, int> umap;
        umap[0] = -1;
        for(int i = 0; i < nums.size(); i++) {
            sum += nums[i];
            sum %= k;
            if(umap.find(sum) != umap.end()) {
                if(i - umap[sum] > 1)
                    return true;
            } else
                umap[sum] = i;
        }
        return false;
    }
};
