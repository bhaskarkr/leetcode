/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    int maxLevelSum(TreeNode* root) {
        if(!root)
            return 0;
        queue<TreeNode*> Q;
        Q.push(root);
        int ans = INT_MIN;
        int index = 1;
        int c = 0;
        while(!Q.empty()) {
            int n = Q.size();
            c++;
            int temp = 0;
            while(n--) {
                auto top = Q.front();
                Q.pop();
                temp += top->val;
                if(top->left)
                    Q.push(top->left);
                if(top->right)
                    Q.push(top->right);
            }
            if(temp > ans) {
                ans = temp;
                index = c;
            }
        }
        return index;
    }
};
