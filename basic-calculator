/*
    TC - O(N)
    SC - O(N)
    Steps:
        1. use stack for storing the current sum
        2. 2 - (1 - 2)
            at '(', ans = 2 and sign = 1
            push current "ans" and sign, so stack{2, 1}, set ans = 0, sign = 1
            '1' ->  num = 1, ans = ans(0) + 1(sign = 1, num = 1) = 1, set num = 0
            '-' -> sign = -1
            '2' -> num = 2, ans = ans(1) - 2 (sign = -1, num = 2) = -1, set num = 0
            ')' -> pop sign -> 1 and multiple with ans(sum of whole bracket), ans = -1*-1=1
                   pop prev sum -> 2  and add with ans(sum of whole bracket), ans = 2+1=3
                   set num = 0
        3. return ans + num*sign
*/

class Solution {
public:
    int calculate(string s) {
        stack<int> stk;
        int num = 0;
        int ans = 0;
        int sign = 1;
        for(int i = 0; i < s.length(); i++) {
            char c = s[i];
            if(isdigit(c))
                num = num*10 + (c-'0');
            else if(c == '+'){
                ans+=num*sign;
                sign = 1;
                num = 0;
            }
            else if(c == '-'){
                ans+=num*sign;
                sign = -1;
                num = 0;
            }
            else if(c == '(') {
                stk.push(ans);
                stk.push(sign);
                ans = 0;
                sign = 1;
            } else if(c == ')'){
                ans+=num*sign;
                ans*=stk.top();
                stk.pop();
                ans+=stk.top();
                stk.pop();
                num = 0;
            }
        }
        return ans + num*sign;
    }
};


class Solution {
public:
    int index = 0;
    int calculate(string s) {
        int ans = 0, sign = 1, num = 0;
        for(;index < s.length(); index++) {
            if(s[index] == '(') {
                ans += sign * num;
                num = 0;
                index++;
                ans += sign * calculate(s);
                sign = 1;
            }
            if(s[index] == '-' || s[index] =='+') {
                ans += sign * num;
                sign = s[index] == '+' ? 1 : -1;
                num = 0;
            }
            if(s[index] == ')') {
                ans += sign * num;
                index++;
                num = 0;
                break;
            }
            if(isdigit(s[index])) {
                num = num * 10 + (s[index] - '0');
            }
        }
        return ans + sign * num;
    }
};
