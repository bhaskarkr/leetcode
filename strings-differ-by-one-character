class Solution {
public:
    bool differByOne(vector<string>& dict) {
        
        int n = dict.size(), m = dict[0].length();
        vector<long> hash(n);
        long MOD = 1000000007;
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                // taking 29 as it is the closest prime
                hash[i] = (29L*hash[i] + (dict[i][j] - 'a')) % MOD; 
            }
        }
        long base = 1;
        for(int j = m - 1; j >= 0; j--) {
            set<long> seen;
            for(int i = 0; i < n; i++) {
                int newHash = (MOD + hash[i] -  ((dict[i][j] - 'a')*base)%MOD) % MOD;
                if(seen.find(newHash) != seen.end())
                    return true;
                seen.insert(newHash);
            }
            base = (base * 29L) % MOD;
        }
        return false;        
    }
};
