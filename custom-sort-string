class Solution {
public:
    string customSortString(string order, string s) {
        vector<int> count(26);
        for(char c : s)
            count[c - 'a']++;
        int i = 0;
        for(char c : order) {
            while(count[c - 'a']-- > 0)
                s[i++] = c;
        }
        for(int j = 0; j < 26; j++) {
            while(count[j]-- > 0)
                s[i++] = (j + 'a');
        }
        return s;
    }
};
