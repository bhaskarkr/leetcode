class Trie {
public:
    bool word;
    vector<Trie*> child;
    Trie(bool isWord) {
        word = isWord;
        child = vector<Trie*>(26, NULL);
    }
};

class WordDictionary {
public:
    /** Initialize your data structure here. */
    Trie* root;
    WordDictionary() {
        root = new Trie(false);
    }
    
    void addWord(string word) {
        Trie* temp = root;
        for(char c : word) {
            if(!temp->child[c-'a'])
                temp->child[c-'a'] = new Trie(false);
            temp = temp->child[c-'a'];
        }
        temp->word = true;
    }
    
    bool search(string word) {
        return searchHelper(root, word, 0);
    }
    
    bool searchHelper(Trie* node, string &word, int index) {
        for(; index < word.length() && node; index++) {
            if(word[index] != '.') 
                node = node->child[word[index]-'a'];
            else {
                Trie* temp = node;
                for(int i = 0; i < 26; i++) {
                    node = temp->child[i];
                    if(searchHelper(node, word, index + 1))
                        return true;
                }
            }
        }
        return node && node->word;
    }
};

