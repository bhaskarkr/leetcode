class Solution {
public:
    int kthSmallest(vector<vector<int>>& matrix, int k) {
        int n = matrix.size();
        int m = matrix[0].size();
        int l = matrix[0][0], h = matrix[n-1][m-1];
        while(l<=h) {
            int m = l + ((h - l) >> 2);
            int count = 0;
            for(int i = 0; i < n; i++) {
                count += upper_bound(matrix[i].begin(), matrix[i].end(), m) - matrix[i].begin();
            }
            if(count < k)
                l = m + 1;
            else
                h = m - 1;
        }
        return l;
    }
};
