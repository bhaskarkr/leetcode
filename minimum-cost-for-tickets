/*
    TC - O(N), N -> max calendar days.
    SC - O(30)
*/
class Solution {
public:
    int mincostTickets(vector<int>& days, vector<int>& costs) {
        set<int> daySet(days.begin(), days.end());
        vector<int> DP(30);
        for(int i = days.front(); i <= days.back(); i++) {
            if(daySet.find(i) == daySet.end())
                DP[i%30] = DP[(i-1)%30];
            else
                DP[i%30] = min(DP[max(0, i - 1)%30] + costs[0], 
                                min(DP[max(0, i - 7)%30] + costs[1], DP[max(0, i - 30)%30] + costs[2])
                              );
        }
        return DP[days.back()%30];
    }
};
