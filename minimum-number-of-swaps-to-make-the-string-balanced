
/*
    TC - O(N)
    SC - O(1)
    Steps:
        1. Since open and close bkt have same count, we will count the unbalanced open brackets
        2. for each swap, we can balance 2 pairs. so ans will be unbalanced/2
        3. but for odd count, lets say ][ -> 1 swap will be required as well for ]][[, also 1 swap is enough
        4. we will make the (count + 1)/2
*/
class Solution {
public:
    int minSwaps(string s) {
        int unbalance = 0;
        for(char c:s){
            if(c=='[')
                unbalance++;
            else {
                if(unbalance > 0)
                    unbalance--;
            }  
        }
        return (unbalance + 1) / 2;
    }
};
