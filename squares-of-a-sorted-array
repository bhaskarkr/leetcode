/*
    TC - O(N)
    SC - O(N)
    Steps:
        1. 2 pointer approach
        2. i = 0, j = n - 1
        3. compare the absolute values, whichever is greater set value at ans[k--], then i++(i selected) or j--(j selected)
        4. repeat until i <= j
*/
class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        int i = 0, j = nums.size() - 1, k = nums.size();
        vector<int> ans(k--);
        while(i<=j) {
            if(abs(nums[i]) > abs(nums[j])) {
                ans[k] = nums[i] * nums[i];
                i++;
                k--;
            } else {
                ans[k] = nums[j] * nums[j];
                j--;
                k--;
            }
        }
        return ans;
    }
};
