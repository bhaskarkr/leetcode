class Solution {
public:
    vector<vector<int>> findRLEArray(vector<vector<int>>& encoded1, vector<vector<int>>& encoded2) {
        vector<vector<int>> ans;
        int prev = -1;
        for(int i = 0, j = 0; i < encoded1.size(), j < encoded2.size();) {
            int minCount = min(encoded1[i][1], encoded2[j][1]);
            int prod = encoded1[i][0]*encoded2[j][0];
            encoded1[i][1]-=minCount;
            encoded2[j][1]-=minCount;
            if(!encoded1[i][1])
                i++;
            if(!encoded2[j][1])
                j++;
            if(prod != prev)
                ans.push_back({prod, minCount});
            else
                ans.back()[1]+=minCount;
            prev = prod;
        }
        return ans;
    }
};
