class Solution {
public:
    int myAtoi(string s) {
        int sign = 1;
        int ans = 0, n = s.length();
        int i = 0;
        while(i < n && s[i] == ' ')
            i++;
        if(i < n && (s[i] == '-' || s[i] == '+'))
            sign = s[i++] == '+' ? 1 : -1;
        while(i < n && isdigit(s[i])) {
            if(ans > INT_MAX/10 || (ans == INT_MAX/10 && INT_MAX%10 < s[i] - '0'))
                return sign > 0 ? INT_MAX : INT_MIN;
            ans = ans * 10 + (s[i] - '0');
            i++;
        }
        return sign * ans;
    }
};
