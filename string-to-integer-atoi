class Solution {
public:
    int myAtoi(string s) {
        int sign = 1;
        int ans = 0, n = s.length();
        int i = 0;
        while(i < n && s[i] == ' ')
            i++;
        if(i < n && (s[i] == '-' || s[i] == '+'))
            sign = s[i++] == '+' ? 1 : -1;
        while(i < n && isdigit(s[i])) {
            if(ans > INT_MAX/10 || (ans == INT_MAX/10 && INT_MAX%10 < s[i] - '0'))
                return sign > 0 ? INT_MAX : INT_MIN;
            ans = ans * 10 + (s[i] - '0');
            i++;
        }
        return sign * ans;
    }
};


class Solution {
public:
    int myAtoi(string s) {
        long ans = 0;
        int sign = 0;
        bool foundDigit = false;
        for(char c : s) {
            if(c == ' ' &&  !foundDigit && sign == 0)
                continue;
            if(c == '-' || c == '+') {
                if(foundDigit || sign != 0) {
                    break;  
                }
                sign = c == '-' ? -1 : 1;
                ans = ans * -1;
            }
            else if(isdigit(c)) {
                foundDigit = true;
                ans = ans * 10 + c - '0';
            }  
            else 
                break;
            if(ans > INT_MAX || ans < INT_MIN)
                break;
        }
        ans = (sign == 0 ? 1 : sign) * ans;
        return ans > INT_MAX ? INT_MAX : ans < INT_MIN ? INT_MIN : ans;
    }
};
