class Solution {
public:
    int compress(vector<char>& chars) {
        int i = 0, j = 0;
        while(i < chars.size()) {
            int c = 0;
            char curr = chars[i];
            while(i < chars.size() && chars[i] == curr) {
                i++;
                c++;
            }
            chars[j++] = curr;
            if(c != 1) {
                for(char nC : to_string(c))
                    chars[j++] = nC;
            }       
        }
        return j;
    }
    
