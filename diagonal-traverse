class Solution {
public:
    vector<int> findDiagonalOrder(vector<vector<int>>& mat) {
        unordered_map<int, vector<int>> map;
        int n = mat.size();
        int m = mat[0].size();
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                map[i+j].push_back(mat[i][j]);
            }
        }
        
        vector<int> ans;
        for(int i = 0; i < n+m; i++) {
            if(i%2 == 0) {
                ans.insert(ans.end(), map[i].rbegin(), map[i].rend()); 
            } else {
                ans.insert(ans.end(), map[i].begin(), map[i].end());
            }   
        }
        return ans;
    }
};


class Solution {
public:
    vector<int> findDiagonalOrder(vector<vector<int>>& mat) {
        vector<int> ans;
        int r = 0, c = 0, m = mat.size(), n = mat[0].size();
        bool up = true;
        while(ans.size() < m * n) {
            ans.push_back(mat[r][c]);
            if(up) {
                if(c == n - 1) {
                    r++;
                    up = false;
                } else if(r == 0) {
                    c++;
                    up = false;
                } else {
                    r--;
                    c++;
                }
            } else {
                if(r == m - 1) {
                    c++;
                    up = true;
                } else if(c == 0) {
                    r++;
                    up = true;
                } else {
                    r++;
                    c--;
                }
            }
        }
        return ans;
    }
};
