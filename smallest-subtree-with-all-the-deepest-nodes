/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    TreeNode* subtreeWithAllDeepest(TreeNode* root) {
        return helper(root).second;
    }
    
    pair<int, TreeNode*> helper(TreeNode* root) {
        if(!root)
            return make_pair(0, root);
        pair<int, TreeNode*> left = helper(root->left);
        pair<int, TreeNode*> right = helper(root->right);
        if(left.first == right.first)
            return make_pair(left.first + 1, root);
        else if(left.first > right.first)
            return make_pair(left.first + 1, left.second);
        else 
            return make_pair(right.first + 1, right.second);
    }
};


/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    pair<TreeNode*, int> helper(TreeNode* root, int d) {
        if(!root)
            return {NULL, d};
        auto left = helper(root->left, d + 1);
        auto right = helper(root->right, d + 1);
        if(left.second > right.second)
            return left;
        else if(left.second < right.second) {
            return right;
        }
        return {root, left.second};
    }
    TreeNode* subtreeWithAllDeepest(TreeNode* root) {
        return helper(root, 0).first;
    }
};
