/*
    TC - O(log(N - k))
    SC - O(1)
    Steps:
        1. will find the left bound
        2. range for left bound will be, 0 to arr.size() - k
        3. use binary search and find mid, to check if mid is closer to x than mid + k
            then move the right to mid other wise left to mid + 1
        4. return the arr from left to left + k
*/
class Solution {
public:
    vector<int> findClosestElements(vector<int>& arr, int k, int x) {
        int l = 0, r = arr.size() - k;
        while(l < r) {
            int m = l + (r - l) / 2;
            if(x - arr[m] > arr[m + k] - x)
                l = m + 1;
            else
                r = m;
        }
        return vector<int>(arr.begin() + l, arr.begin() + l + k);
    }
};
