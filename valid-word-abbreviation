/*
    TC - O(N)
    SC - O(1)
    Steps:
        1. use 2 pointer approach
        2. if both char are same, i++, j++
        3. else if not digit or 0, reture false
        4. else calculate the num, and increment i = i + num
        5. return both i and j equals the length of each word
*/
class Solution {
public:
    bool validWordAbbreviation(string word, string abbr) {
        int i = 0, j = 0;
        while(i < word.length() && j < abbr.length()) {
            if(word[i] == abbr[j]) {
                i++;
                j++;
            } else if(!isdigit(abbr[j]) || (isdigit(abbr[j]) && abbr[j]=='0'))
                return false;
            else if(isdigit(abbr[j])) {
                int num = 0;
                while(j < abbr.length() && isdigit(abbr[j])) {
                    num = num * 10 + (abbr[j++]-'0') ;
                }
                i+=num;
                num = 0;
            }
        }
        return i == word.length() && j == abbr.length();
    }
};

class Solution {
public:
    bool validWordAbbreviation(string word, string abbr) {
        int num = 0;
        int i = 0, j = 0;
        while(i < word.length() && j < abbr.length()) {
            if(word[i] == abbr[j]) {
                j++;
                i++;
            } else if(isdigit(abbr[j]) && abbr[j] != '0') {
                while(j < abbr.length() && isdigit(abbr[j])) {
                    num = num * 10 + (abbr[j] - '0');
                    j++;
                }
                i += num;
                num = 0;
            } else {
                return false;
            }
        }
        return i == word.length() && j == abbr.length();
    }
};
