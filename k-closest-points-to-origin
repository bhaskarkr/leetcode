class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        priority_queue<pair<int, int>> PQ;
        vector<vector<int>> ans(k);
        int i = 0;
        for(auto point : points) {
            int dist = point[0]*point[0] + point[1]*point[1];
            if(PQ.size() == k) {
                if(PQ.top().first > dist) {
                    PQ.pop();
                    PQ.push(make_pair(dist, i));
                }
            } else{
                PQ.push(make_pair(dist, i));
            }
            i++;
        }
        i = 0;
        while(!PQ.empty()) {
            ans[i++] = points[PQ.top().second];
            PQ.pop();
        } 
        return ans;
    }
};


class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        priority_queue<pair<long, int>> pq;
        for(int i = 0; i < points.size(); i++) {
            pq.push({points[i][0]*points[i][0] + points[i][1]*points[i][1], i});
            if(pq.size() > k)
                pq.pop();
        }
        vector<vector<int>> ans;
        while(!pq.empty()) {
            ans.push_back(points[pq.top().second]);
            pq.pop();
        }
        return ans;
    }
};


class Solution {
public:

    int quick_select(vector<vector<int>>& points, int l, int r) {
        auto pivot = points[l];
        long temp = points[l][0]*points[l][0] + points[l][1]*points[l][1];
        while(l < r) {
            while(l < r and points[r][0]*points[r][0] + points[r][1]*points[r][1] >= temp) {
                r--;
            }
            points[l] = points[r];
            while(l < r and points[l][0]*points[l][0] + points[l][1]*points[l][1] <= temp) {
                l++;
            }
            points[r] = points[l];
        }
        points[l] = pivot;
        return l;
    }
    
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        int l = 0, r = points.size() - 1;
        while(l < r) {
            int m = quick_select(points, l, r);
            if(m == k)
                break;
            else if(m > k)
                r = m - 1;
            else
                l = m + 1;
        }
        vector<vector<int>> ans(points.begin(), points.begin() + k);
        return ans;
    }
};
