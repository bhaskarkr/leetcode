// TC - O(n*n)
// SC - O(1)
class Solution {
public:
    int numFriendRequests(vector<int>& ages) {
        int ans = 0;
        unordered_map<int, int> map;
        for(int num : ages)
            map[num]++;
        for(auto [key1, val1] : map) {
            for(auto [key2, val2] :  map)
                ans += isValidFR(key1, key2) ? (val1 * (key1 == key2 ? val1 - 1 : val2)) : 0;
        }
        return ans;
    }
    
    bool isValidFR(int a, int b) {
        return !((a <= 0.5*b + 7) || a > b);
    }
};

