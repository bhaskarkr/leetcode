class Solution {
public:
    string addBoldTag(string s, vector<string>& words) {
        vector<pair<int, int>> boldRange;
        for(string word : words) {
            for(int i = 0; i < s.length(); i++) {
                i = s.find(word, i);
                if(i == string::npos)
                    break;
                boldRange.push_back(make_pair(i, i + word.length()));
            }
        }
        sort(boldRange.begin(), boldRange.end());
        vector<pair<int, int>> mergedRange;
        for(int i = 0; i < boldRange.size(); i++) {
            if(i == 0 || mergedRange.back().second < boldRange[i].first) {
                mergedRange.push_back(boldRange[i]);
            } else {
                mergedRange.back().second = max(boldRange[i].second, mergedRange.back().second);
            }
        }
        
        for(auto itr = mergedRange.rbegin(); itr != mergedRange.rend(); itr++) {
            s.insert(itr->second, "</b>");
            s.insert(itr->first, "<b>");
        }
        return s;
    }
};

class Solution {
public:
    string addBoldTag(string &s, vector<string>& words) {
        vector<pair<int, int>> boldIntervalList;
        for(auto &word : words) {
            for(int i = 0; i < s.length(); i++) {
                auto index = s.find(word, i);
                if(index != string::npos)
                    boldIntervalList.push_back({index, index + word.length()});
            }
        }
        sort(boldIntervalList.begin(), boldIntervalList.end());
        vector<pair<int, int>> mergedIntervalList;
        for(int i = 0; i < boldIntervalList.size(); i++) {
            if(mergedIntervalList.empty() || mergedIntervalList.back().second < boldIntervalList[i].first) {
                mergedIntervalList.push_back(boldIntervalList[i]);
            } else {
                mergedIntervalList.back().second = max(mergedIntervalList.back().second, boldIntervalList[i].second);
            }
        }

        for(int i = mergedIntervalList.size() - 1; i >= 0; i--) {
            s.insert(mergedIntervalList[i].second, "</b>");
            s.insert(mergedIntervalList[i].first, "<b>");
        }
        return s;
    }
};
