/*
    TC - O(N)
    SC - O(1)
    Steps:
        1. we will make both the pointer traverse same distance.
        2. once a pointer "a = p" reaches to root and after that reassign it to "q"
         and pointer "b = q" reaches to root and after that reassign it to "p"
        3. return a
*/

class Solution {
public:
    Node* lowestCommonAncestor(Node* p, Node * q) {
        Node* a = p; 
        Node* b = q;
        while(a!=b) {
            a = (a->parent ? a->parent : q);
            b = (b->parent ? b->parent : p);
        }
        return a;
    }
};

