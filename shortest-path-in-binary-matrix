class Solution {
public:
    int shortestPathBinaryMatrix(vector<vector<int>>& grid) {
        pair<int, int> start = make_pair(0,0);
        int n = grid.size();
        int m = grid[0].size();
        pair<int, int> end = make_pair(grid.size() - 1, grid[0].size() -1);
        queue<pair<int,int>> Q;
        if(grid[0][0])
            return -1;
        Q.push(start);
        int level = 0;
        vector<int> dirX = {-1, -1, 0, 1, 1, 1, 0, -1};
        vector<int> dirY = {0, 1, 1, 1, 0, -1, -1, -1};
        while(!Q.empty()) {
            int currentChildren = Q.size();
            while(currentChildren--) {
                pair<int, int> top = Q.front();
                Q.pop();
                if(top == end) {
                    return level+1;
                }
                for(int d = 0; d < 8; d++) {
                    int nx = top.first + dirX[d];
                    int ny = top.second + dirY[d];
                    if(nx < n && nx >=0 && ny < m && ny >=0 && !grid[nx][ny]) {
                        grid[nx][ny] = 1;
                        Q.push(make_pair(nx, ny));
                    }
                }
            }
            level++;
        }
        return -1;
    }
};


class Solution {
public:
    int shortestPathBinaryMatrix(vector<vector<int>>& grid) {
        queue<vector<int>> q;
        int m = grid.size(), n = grid[0].size();
        int ans = 1;
        if(grid[0][0])
            return -1;
        q.push({0, 0});
        while(!q.empty()) {
            int c = q.size();
            while(c--) {
                auto curr = q.front();
                q.pop();
                if(curr[0] == m - 1 and curr[1] == n - 1)
                    return ans;
                for(int i = -1; i < 2; i++) {
                    for(int j = -1; j < 2; j++) {
                        if(i == 0 and j == 0)
                            continue;
                        int nx = curr[0] + i, ny = curr[1] + j;
                        if(nx < 0 || ny < 0 || nx >= m or ny >= n or grid[nx][ny])
                            continue;
                        grid[nx][ny] = 1;
                        q.push({nx, ny});
                    }
                }
            }
            ans++;
        }
        return -1;
    }
};
