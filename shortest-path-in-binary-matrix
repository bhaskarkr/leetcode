class Solution {
public:
    int shortestPathBinaryMatrix(vector<vector<int>>& grid) {
        pair<int, int> start = make_pair(0,0);
        int n = grid.size();
        int m = grid[0].size();
        pair<int, int> end = make_pair(grid.size() - 1, grid[0].size() -1);
        queue<pair<int,int>> Q;
        if(grid[0][0])
            return -1;
        Q.push(start);
        int level = 0;
        vector<int> dirX = {-1, -1, 0, 1, 1, 1, 0, -1};
        vector<int> dirY = {0, 1, 1, 1, 0, -1, -1, -1};
        while(!Q.empty()) {
            int currentChildren = Q.size();
            while(currentChildren--) {
                pair<int, int> top = Q.front();
                Q.pop();
                if(top == end) {
                    return level+1;
                }
                for(int d = 0; d < 8; d++) {
                    int nx = top.first + dirX[d];
                    int ny = top.second + dirY[d];
                    if(nx < n && nx >=0 && ny < m && ny >=0 && !grid[nx][ny]) {
                        grid[nx][ny] = 1;
                        Q.push(make_pair(nx, ny));
                    }
                }
            }
            level++;
        }
        return -1;
    }
};
