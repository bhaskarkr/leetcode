class Solution {
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>> ans;
        ans.push_back({});
        for(int i = 0; i < nums.size(); i++) {
            if(i > 0 && nums[i] == nums[i - 1])
                continue;
            int temp = ans.size();
            for(int j = 0; j < temp; j++) {
               vector<int> tempVec = ans[j];
               tempVec.push_back(nums[i]);
               ans.push_back(tempVec); 
            }
        }
        return ans;
    }
};
