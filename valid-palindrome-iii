class Solution {
public:
    /*
        Using longest common subsequence
                a.  b.  c.  a.  
            0   0   0   0   0
        a.  0   1   1   1   1
        c.  0   1   1   2   2
        b.  0   1   2   2   2
        a.  0   1   2   2   3
    */
    
    bool isValidPalindrome(string s, int k) {
        int n = s.length();
        string r(s);
        reverse(r.begin(), r.end());
        vector<vector<int>> DP(n+1, vector<int> (n+1));
        for(int i = 1; i <= n; i++) {
            for(int j = 1; j <= n; j++) {
                if(s[i-1] == r[j-1])
                    DP[i][j] = DP[i-1][j-1] + 1;
                else
                    DP[i][j] = max(DP[i-1][j], DP[i][j-1]);
            }
        }
        return n - DP[n][n] <= k;
    }
};
