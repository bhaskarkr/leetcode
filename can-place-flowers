class Solution {
public:
    bool canPlaceFlowers(vector<int>& flowerbed, int n) {
        for(int i = 0 ; i < flowerbed.size() && n; i++) {
            if(flowerbed[i]) {
                i++;
            } else {
                if(i == flowerbed.size() - 1 || !flowerbed[i + 1]) {
                     n--;
                     i++;
                }
                   
            }
        }
        return !n;
    }
};



class Solution {
public:
    bool canPlaceFlowers(vector<int>& flowerbed, int n) {
        for(int i = 0; i < flowerbed.size() and n ; i++) {
            if(!flowerbed[i] && (i == 0 || !flowerbed[i-1]) && (i == flowerbed.size() - 1 || !flowerbed[i+1])) {
                flowerbed[i]++;
                n--;
            }  
        }
        return n == 0;
    }
};
