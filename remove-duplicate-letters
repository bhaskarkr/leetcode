class Solution {
public:
    string removeDuplicateLetters(string s) {
        stack<char> stk;
        vector<bool> visited(26);
        vector<int> count(26);
        for(char c :  s)
            count[c-'a']++;
        for(char c :  s) {
            count[c-'a']--;
            if(visited[c-'a'])
                continue;
            while(!stk.empty() && c < stk.top() && count[stk.top()-'a']) {
                visited[stk.top()-'a'] = false;
                stk.pop();
            }
            stk.push(c);
            visited[c-'a'] = true;
        }
        string ans = "";
        while(!stk.empty()) {
            ans = stk.top() + ans;
            stk.pop();
        }
        return ans;
    }
};
