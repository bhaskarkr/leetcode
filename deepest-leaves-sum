/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    
    void solver(TreeNode* root, int depth, int &sum, int &maxDepth) {
        if(!root)
            return;
        if(maxDepth < depth) {
            maxDepth = depth;
            sum = 0;
        }
        if(depth == maxDepth)
            sum += root->val;
        solver(root->left, depth + 1, sum, maxDepth);
        solver(root->right, depth + 1, sum, maxDepth);
    }
    
    int deepestLeavesSum(TreeNode* root) {
        int maxDepth = 0;
        int sum = 0;
        solver(root, 1, sum, maxDepth);
        return sum;
    }
};
