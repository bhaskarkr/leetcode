class Solution {
public:
    bool isCompleteTree(TreeNode* root) {
        queue<TreeNode*> Q;
        Q.push(root);
        bool foundLast = false;
        while(!Q.empty()) {
            auto top = Q.front();
            Q.pop();
            if(!top)
                foundLast = true;
            else {
                if(foundLast)
                    return false;
                Q.push(top->left);
                Q.push(top->right);
            }
        }
        return true;
    }
};

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    bool isCompleteTree(TreeNode* root) {
        queue<TreeNode*> Q;
        bool foundNull = false;
        Q.push(root);
        while(!Q.empty()) {
            auto curr = Q.front();
            Q.pop();
            if(curr and foundNull)
                return false;
            if(!curr)
                foundNull = true;
            if(curr) {
                Q.push(curr->left);
                Q.push(curr->right);
            }   
        }
        return true;
    }
};
