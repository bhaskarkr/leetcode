/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */

/*
    TC - O(N)
    SC - O(N)
    Steps:
        1. convert BST to Sorted Array
        2. convert back sorted array to BST, using divide and conquer 
*/
class Solution {
public:
    TreeNode* balanceBST(TreeNode* root) {
        vector<TreeNode*> sortedNodes;
        convertBstToSortedVector(root, sortedNodes);
        return convertVectorToBst(0, sortedNodes.size() - 1, sortedNodes);
    }
    
    void convertBstToSortedVector(TreeNode* root, vector<TreeNode*> &sortedNodes) {
        if(!root)
            return;
        convertBstToSortedVector(root->left, sortedNodes);
        sortedNodes.push_back(root);
        convertBstToSortedVector(root->right, sortedNodes);
    }
    
    TreeNode* convertVectorToBst(int left, int right, vector<TreeNode*> &sortedNodes) {
        if(left > right)
            return NULL;
        int mid = right - (right - left) / 2;
        TreeNode* root = sortedNodes[mid];
        root->left = convertVectorToBst(left, mid - 1, sortedNodes);
        root->right = convertVectorToBst(mid + 1, right, sortedNodes);
        return root;
    }
};
