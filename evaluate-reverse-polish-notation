class Solution {
public:
    int evalRPN(vector<string>& tokens) {
        stack<int> stk;
        unordered_map<string, int> ops = {{"+", 1},
                                          {"-", 2},
                                          {"*", 3},
                                          {"/", 4}};
        for(string token :  tokens) {
            if(ops[token]) {
                stk.push(getEval(stk, ops[token]));
            } else {
                stk.push(stoi(token));   
            }
        }
        return stk.top();
    }
    
    int getEval(stack<int> &stk, int op) {
        int n1 = stk.top();
        stk.pop();
        int n2 = stk.top();
        stk.pop();
        switch(op) {
            case 1 : return n2 + n1;   
            case 2 : return n2 - n1; 
            case 3 : return n2 * n1; 
            case 4 : return n2 / n1; 
        }
        return 0;
    }
};
