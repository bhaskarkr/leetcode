class Solution {
public:
    vector<int> findBuildings(vector<int>& heights) {
        vector<int> ans;
        int right = 0;
        for(int i = heights.size() - 1; i >= 0; i--) {
            if(right < heights[i])
                ans.push_back(i);
            right = max(right, heights[i]);
        }
        reverse(ans.begin(), ans.end());
        return ans;
    }
};
