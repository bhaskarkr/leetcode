
/*
    TC - O(N)
    SC - O(N)
    Steps:
        1. we will use "ans" string itself  as stack
        2. if stack not empty and top is same as current char, pop
        3. otherwise push_bacK(current_char)
        4. return ans
*/
class Solution {
public:
    string removeDuplicates(string s) {
        string ans = "";
        for(char c : s) {
            if(ans.length() && ans.back() == c)
                ans.pop_back();
            else
                ans.push_back(c); 
        }
        return ans;
    }
};
