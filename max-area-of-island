class Solution {
public:
    vector<int> dy = {-1, 0, 1, 0}, dx = {0, -1, 0, 1};
    int maxAreaOfIsland(vector<vector<int>>& grid) {
        int ans = 0;
        int n = grid.size(), m = grid[0].size();
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(grid[i][j])
                    ans = max(ans, dfs(grid, i, j, n, m));
            }
        }
        return ans;
    }
    
    int dfs(vector<vector<int>>& grid, int i, int j, int n, int m) {
        int temp = 1;
        grid[i][j] = 0;
        for(int k = 0; k < 4; k++) {
            int newI = i + dx[k];
            int newJ = j + dy[k];
            if(newI < 0 || newI >= n || newJ < 0 || newJ >= m || !grid[newI][newJ])
                continue;
            temp+=dfs(grid, newI, newJ, n, m);
        }
        return temp;
    }
    
};
