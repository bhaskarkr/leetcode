class Solution {
public:
    double angleClock(int hour, int minutes) {
        double oneMinDegree = 6;
        double oneHourDegree = 30;
        double hourWithMinute = hour + (1.0 * minutes) / 60;
        double diff = abs(minutes*oneMinDegree - hourWithMinute*oneHourDegree);
        double ans = min(diff, 360 - diff);
        return ans; 
    }
};
