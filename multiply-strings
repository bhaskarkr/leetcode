            for(int j = m - 1; j >= 0; j--) {
                int prod = (num1[i] - '0')*(num2[j] - '0') + prodArr[i+j+1];
                prodArr[i+j] += prod/10;
                prodArr[i+j+1] = prod%10;
            }
        }
        
