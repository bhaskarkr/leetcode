        for(int i = 0; i < n + m; i++) {
            if(prodArr[i] == 0 && ans.length() == 0)
                continue;
            ans = ans + (char)(prodArr[i] + '0'); 
        }
        return ans.length() == 0 ? "0" : ans;
    }
    
    
