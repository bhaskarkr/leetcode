class Solution {
public:
    vector<string> findMissingRanges(vector<int>& nums, int lower, int upper) {
        int prev = lower - 1;
        vector<string> ans;
        nums.push_back(upper + 1);
        for(int i = 0; i < nums.size(); i++) {
            int diff = nums[i] - prev;
            if(diff > 2) {
                ans.push_back(to_string(prev+1) + "->" + to_string(nums[i] - 1));
            } else if(diff == 2)
                ans.push_back(to_string(prev+1));
            prev = nums[i];
        }
        return ans;
    }
};
