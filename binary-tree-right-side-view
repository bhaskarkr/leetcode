/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */

/*
    TC - O(N)
    SC - O(1)
    Steps:
        1. We will traverse the tree in post order
        2. we will maintain a maxDepth, and whenever the current depth is greater than the maxDepth. we will update the maxDepth and add the current node to "ans".
        3. return ans
*/
class Solution {
public:
    vector<int> rightSideView(TreeNode* root) {
        vector<int> ans;
        int maxDepth = 0;
        solver(root, 1, maxDepth, ans);
        return ans;
    }
    
    void solver(TreeNode* root, int depth, int &maxDepth, vector<int> &ans) {
        if(!root)
            return;
        if(depth > maxDepth) {
            maxDepth = depth;
            ans.push_back(root->val);
        }
        solver(root->right, depth + 1, maxDepth, ans);
        solver(root->left, depth + 1, maxDepth, ans);
    }
};
