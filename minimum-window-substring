class Solution {
public:
    string minWindow(string s, string t) {
        unordered_map<char, int> need;
        int missing = t.length();
        for(char c : t)
            need[c]++;
        int minLen = INT_MAX, start = 0;
        for(int i = 0, j = 0; i < s.length(); i++) {
            if(need[s[i]] > 0)
                missing--;
            need[s[i]]--;
            if(missing == 0) {
                while(j <= i && need[s[j]] < 0)
                    need[s[j++]]++;
                if(minLen == INT_MAX || i - j + 1 < minLen) {
                    start = j;
                    minLen = i - j + 1;
                }
                need[s[j++]]++;
                missing++;
            }
        }
        return s.substr(start, minLen == INT_MAX ? start : minLen);
    }
};
