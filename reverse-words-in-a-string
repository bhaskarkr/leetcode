class Solution {
public:
    string reverseWords(string s) {
        reverse(s.begin(), s.end());
        reverseWord(s);
        return cleanSpace(s);
    }
    void reverseWord(string &s) {
        int start = 0, end = 0, n = s.length();
        while(start < n) {
            while(start < n && s[start] == ' ')
                start++;
            end  = start + 1;
            while(end < n && s[end] != ' ')
                end++;
            reverse(s.begin() + start, s.begin() + end);
            start = end + 1;
        }
    }
    
    string cleanSpace(string &s) {
        int j = 0, n = s.length();
        for(int i = 0; i < n; i++) {
            if(isalnum(s[i]))
                s[j++] = s[i];
            else if(s[i] == ' ') {
                 if(i > 0 && isalnum(s[i - 1]))
                     s[j++] = s[i];
            }
        }
        if(n && s[n-1] == ' ')
            j--;
        return s.substr(0, j);
    }
};
