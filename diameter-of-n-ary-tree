/*
    TC - O(N)
    SC - O(1)
    Steps:
        1. We will take DFS approach
        2. And for each node we will find the max 2 children depths
        3. update ans if current diameter is max with left + right (not including current because we have to count edges)
        4. return max child depth including current node 1 + max(maxChild, secondMaxChild)
*/

class Solution {
public:
    int diameter(Node* root) {
        int ans = 0;
        solver(root, ans);
        return max(ans, 0);
    }
    
    int solver(Node* root, int &ans) {
        if(!root)
            return 0;
        int maxChild = 0;
        int secondMaxChild = 0;
        for(int i = 0; i < root->children.size(); i++) {
            int child = solver(root->children[i], ans);
            if(child > maxChild) {
                secondMaxChild = maxChild;
                maxChild = child;
            } else if(child > secondMaxChild){
                secondMaxChild = child;
            }
        }
        ans = max(ans, maxChild + secondMaxChild);
        return 1 + max(maxChild, secondMaxChild);
    }
};
