class Solution {
public:
    double dfs(vector<vector<int>>& matrix, int curr, double prob, int target, int tMax, int tCurr, int prev) { 
        int childSize = matrix[curr].size() - 1;
        if(tCurr > tMax) {
            return 0;
        }
        if(curr == target) {
            return childSize == 0 || tCurr == tMax ? prob : 0;
        }
        double tempProb = 0;
        for(int i = 0; i < matrix[curr].size(); i++) {
            if(matrix[curr][i] != prev) {
                tempProb = max(tempProb, dfs(matrix, matrix[curr][i], prob/childSize, target, tMax, tCurr + 1, curr));
            }
        }
        return tempProb;
    }
    double frogPosition(int n, vector<vector<int>>& edges, int t, int target) {
        vector<vector<int>> matrix(n+1);
        matrix[1].push_back(0);
        for(auto edge : edges) {
            matrix[edge[0]].push_back(edge[1]);
            matrix[edge[1]].push_back(edge[0]);
        }
        return dfs(matrix, 1, 1, target, t, 0, -1);
    }
};
