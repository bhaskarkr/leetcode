class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        sort(strs.begin(), strs.end());
        int i = 0;
        for(; i < strs[0].length() && i < strs[strs.size() - 1].length(); i++) {
            if(strs[0][i] != strs[strs.size() - 1][i])
                return strs[0].substr(0, i);       
        }
        return strs[0].substr(0, i);
    }
};


class Solution2 {
public:
    string longestCommonPrefix(vector<string>& strs) {
        int minLength = strs[0].length();
        unordered_set<string> wordMap;
        for(auto str : strs) {
            wordMap.insert(str);
            minLength = minLength < str.length() ? minLength : str.length();
        }
        string ans = strs[0].substr(0, minLength);
        for(auto k : wordMap) {
            for(int i = 0; i < minLength; i++) {
                if(ans[i] != k[i]) {
                    minLength = i;
                    ans = k.substr(0, i);
                    break;
                }
            }
        }
        return ans;
    }
};
