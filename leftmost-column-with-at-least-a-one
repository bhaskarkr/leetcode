/**
 * // This is the BinaryMatrix's API interface.
 * // You should not implement it, or speculate about its implementation
 * class BinaryMatrix {
 *   public:
 *     int get(int row, int col);
 *     vector<int> dimensions();
 * };
 */
/*
    TC - O(row*log(col))
    SC - O(1)
    Steps:
        1. for each row we will apply binary search
        2. for each finding of "1" we will update "ans" with min(ans, currColIndex)
        3. return ans if has has changed other wise return -1
*/
class Solution {
public:
    int leftMostColumnWithOne(BinaryMatrix &binaryMatrix) {
        vector<int> dimen = binaryMatrix.dimensions();
        int ans = INT_MAX;
        for(int i = 0; i < dimen[0]; i++) {
            int l = 0, r = dimen[1] - 1;
            while(l <= r) {
                int m = (l + r)/2;
                int val = binaryMatrix.get(i, m);
                if(val) {
                   ans = min(ans, m); 
                   r = m - 1;
                } else {
                    l = m + 1;
                }
            }
        }
        return ans == INT_MAX ? -1 : ans;
    }
};
